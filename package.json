{
  "name": "create-stack-standards",
  "version": "0.0.0",
  "description": "Generate a Vite + React project once, with non-feature concerns built in.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-stack-standards": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
